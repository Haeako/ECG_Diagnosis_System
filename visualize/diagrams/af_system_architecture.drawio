<mxCell id="title" value="&lt;b&gt;HỆ THỐNG SÀNG LỌC AF HAI TẦNG — THIẾT BỊ &amp;amp; SERVER&lt;/b&gt;" style="text;html=1;align=left;fontSize=29;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="60" y="25" width="2200" height="55" as="geometry" /></mxCell>
<mxCell id="subtitle" value="Thiết kế đề xuất • Kết quả tại chỗ + phân tích server + bằng chứng giải thích • Đồng bộ theo record_id và khoảng thời gian ECG" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="60" y="85" width="2300" height="42" as="geometry" /></mxCell>
<mxCell id="device_lane" value="THIẾT BỊ / ESP32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;verticalAlign=top;align=left;spacingTop=16;spacingLeft=18;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="55" y="160" width="1910" height="430" as="geometry" /></mxCell>
<mxCell id="server_lane" value="SERVER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#22A06B;strokeWidth=2;verticalAlign=top;align=left;spacingTop=16;spacingLeft=18;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="55" y="665" width="1910" height="570" as="geometry" /></mxCell>
<mxCell id="result_lane" value="KẾT QUẢ CHO NGƯỜI DÙNG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;verticalAlign=top;align=left;spacingTop=16;spacingLeft=14;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2010" y="160" width="360" height="1075" as="geometry" /></mxCell>
<mxCell id="raw" value="&lt;b&gt;Thu nhận ECG gốc&lt;/b&gt;&lt;br&gt;ADC + timestamp&lt;br&gt;record_id / số thứ tự mẫu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="85" y="245" width="205" height="105" as="geometry" /></mxCell>
<mxCell id="pre" value="&lt;b&gt;Tiền xử lý nhân quả&lt;/b&gt;&lt;br&gt;Loại trôi nền / notch 50 Hz&lt;br&gt;Cấu hình thống nhất khi đánh giá" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="350" y="245" width="205" height="105" as="geometry" /></mxCell>
<mxCell id="qrs" value="&lt;b&gt;Detector firmware hiện tại (liên tục)&lt;/b&gt;&lt;br&gt;Đỉnh R → RR / BPM&lt;br&gt;Lựa chọn từ AF downstream" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="615" y="245" width="200" height="105" as="geometry" /></mxCell>
<mxCell id="feat" value="&lt;b&gt;5 đặc trưng RR&lt;/b&gt;&lt;br&gt;pNN50 · entropy · SD2&lt;br&gt;SD1/SD2 · median RR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="875" y="245" width="205" height="105" as="geometry" /></mxCell>
<mxCell id="et" value="&lt;b&gt;Extra Trees INT8&lt;/b&gt;&lt;br&gt;Điểm AF + quyết định thô&lt;br&gt;Giữ ngưỡng đã khóa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="1140" y="245" width="205" height="105" as="geometry" /></mxCell>
<mxCell id="policy" value="&lt;b&gt;Chính sách đầu ra&lt;/b&gt;&lt;br&gt;SQI + tính hợp lệ RR&lt;br&gt;+ điểm AF + tuổi kết quả" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="1405" y="245" width="220" height="105" as="geometry" /></mxCell>
<mxCell id="local" value="&lt;b&gt;Kết quả tại chỗ&lt;/b&gt;&lt;br&gt;Trạng thái sàng lọc + BPM&lt;br&gt;Thời gian / chất lượng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="1685" y="245" width="240" height="105" as="geometry" /></mxCell>
<mxCell id="buf" value="&lt;b&gt;Bộ đệm ECG gốc&lt;/b&gt;&lt;br&gt;Đoạn ECG và timestamp&lt;br&gt;Giữ dữ liệu trước / sau sự kiện" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="350" y="430" width="235" height="105" as="geometry" /></mxCell>
<mxCell id="sqi" value="&lt;b&gt;Ước lượng SQI&lt;/b&gt;&lt;br&gt;Ho là ứng viên tham chiếu&lt;br&gt;Toàn pipeline trên ESP32 cần kiểm chứng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#D97706;strokeWidth=1.5;dashed=1;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="875" y="430" width="245" height="110" as="geometry" /></mxCell>
<mxCell id="upload" value="&lt;b&gt;Gói dữ liệu gửi server&lt;/b&gt;&lt;br&gt;ECG gốc + fs + timestamp + SQI&lt;br&gt;R peaks / RR + điểm AF + phiên bản model" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="1635" y="430" width="290" height="115" as="geometry" /></mxCell>
<mxCell id="ingest" value="&lt;b&gt;Tiếp nhận &amp;amp; căn thời gian&lt;/b&gt;&lt;br&gt;Kiểm tra mất mẫu / record_id&lt;br&gt;Giữ kết quả thiết bị để đối chiếu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="85" y="755" width="220" height="115" as="geometry" /></mxCell>
<mxCell id="quality" value="&lt;b&gt;SQI trên ECG gốc&lt;/b&gt;&lt;br&gt;Ghi chất lượng và vùng không dùng được&lt;br&gt;Giữ trạng thái chưa đủ chất lượng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="365" y="755" width="220" height="115" as="geometry" /></mxCell>
<mxCell id="denoise" value="&lt;b&gt;Nhánh khử nhiễu tùy chọn&lt;/b&gt;&lt;br&gt;MECG-E hoặc bypass&lt;br&gt;Đối chiếu ECG trước / sau xử lý" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#D97706;strokeWidth=1.5;dashed=1;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="645" y="755" width="220" height="115" as="geometry" /></mxCell>
<mxCell id="serverqrs" value="&lt;b&gt;Ước lượng R peaks / RR&lt;/b&gt;&lt;br&gt;Detector đơn làm baseline&lt;br&gt;Fusion peaks là thử nghiệm riêng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="925" y="755" width="220" height="115" as="geometry" /></mxCell>
<mxCell id="serverfeat" value="&lt;b&gt;5 đặc trưng RR&lt;/b&gt;&lt;br&gt;Cùng định nghĩa / đơn vị&lt;br&gt;với mô hình đã huấn luyện" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="1205" y="755" width="220" height="115" as="geometry" /></mxCell>
<mxCell id="serveret" value="&lt;b&gt;Extra Trees float&lt;/b&gt;&lt;br&gt;Điểm AF nhánh RR&lt;br&gt;Ngưỡng được giữ cố định" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="1485" y="755" width="205" height="115" as="geometry" /></mxCell>
<mxCell id="shap" value="&lt;b&gt;TreeSHAP&lt;/b&gt;&lt;br&gt;Giải thích nhánh Extra Trees&lt;br&gt;Feature đóng góp + đoạn RR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="1750" y="755" width="175" height="115" as="geometry" /></mxCell>
<mxCell id="founder" value="&lt;b&gt;ECGFounder + đầu logistic&lt;/b&gt;&lt;br&gt;Nhận waveform ECG trực tiếp&lt;br&gt;Tiền xử lý theo giao thức model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="925" y="1000" width="280" height="115" as="geometry" /></mxCell>
<mxCell id="combine" value="&lt;b&gt;Đối chiếu / kết hợp quyết định&lt;/b&gt;&lt;br&gt;Extra Trees + ECGFounder + SQI&lt;br&gt;Đối chiếu kết quả tại chỗ&lt;br&gt;Quy tắc cần chốt trên validation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="1390" y="1000" width="300" height="130" as="geometry" /></mxCell>
<mxCell id="report" value="&lt;b&gt;Gói kết quả server&lt;/b&gt;&lt;br&gt;Trạng thái + điểm từng nhánh&lt;br&gt;BPM / RR / ECG + giải thích&lt;br&gt;Timestamp + phiên bản xử lý" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="1750" y="1000" width="175" height="140" as="geometry" /></mxCell>
<mxCell id="ui_local" value="&lt;b&gt;1. Kết quả ban đầu&lt;/b&gt;&lt;br&gt;Hiển thị tại chỗ&lt;br&gt;Ghi rõ nguồn: thiết bị&lt;br&gt;Hiển thị trạng thái chờ server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.5;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="2040" y="265" width="300" height="150" as="geometry" /></mxCell>
<mxCell id="ui_final" value="&lt;b&gt;2. Kết quả server cập nhật&lt;/b&gt;&lt;br&gt;Gắn đúng đoạn đo&lt;br&gt;Lưu kết quả trước và sau cập nhật&lt;br&gt;Hiển thị nếu hai nhánh bất đồng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.5;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="2040" y="855" width="300" height="150" as="geometry" /></mxCell>
<mxCell id="states" value="&lt;b&gt;Trạng thái đầu ra&lt;/b&gt;&lt;br&gt;• Nghi ngờ AF&lt;br&gt;• Chưa phát hiện AF trong đoạn đo&lt;br&gt;• Chưa đủ dữ liệu / chất lượng&lt;br&gt;• Đang chờ phân tích server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.5;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="2040" y="470" width="300" height="200" as="geometry" /></mxCell>
<mxCell id="evidence" value="&lt;b&gt;Bằng chứng đi kèm&lt;/b&gt;&lt;br&gt;ECG có đánh dấu đỉnh R&lt;br&gt;BPM / RR + thời gian đo&lt;br&gt;SQI + vùng abstain&lt;br&gt;Giải thích đúng mô hình" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.5;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="2040" y="1030" width="300" height="170" as="geometry" /></mxCell>
<mxCell id="devnote" value="Gate tác động lên việc xuất kết quả / gửi phân tích. Luồng QRS và AF tiếp tục chạy; SQI không tự xác nhận AF." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="85" y="365" width="1500" height="35" as="geometry" /></mxCell>
<mxCell id="foot" value="&lt;b&gt;Phạm vi kiểm chứng&lt;/b&gt;&lt;br&gt;• Detector được chọn bằng host replay AFDB + LTAFDB và xác nhận SHDB-AF; xem report.md mục 8.&lt;br&gt;• Chưa có số đo mới cho toàn pipeline tích hợp trên ESP32.&lt;br&gt;• Ho đầy đủ trên thiết bị, MECG-E và chính sách kết hợp vẫn cần kiểm chứng.&lt;br&gt;• TreeSHAP giải thích Extra Trees; kết luận kết hợp phải giữ bằng chứng riêng từng nhánh.&lt;br&gt;• Đường liền: dữ liệu/kết quả; nét đứt cam: kích hoạt; khung cam nét đứt: khối tùy chọn." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="75" y="1280" width="2260" height="155" as="geometry" /></mxCell>
