<mxfile host="app.diagrams.net" agent="Codex" version="24.7.17" type="device"><diagram id="af-two-tier" name="Kiến trúc AF hai tầng"><mxGraphModel dx="2450" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2450" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0" />
