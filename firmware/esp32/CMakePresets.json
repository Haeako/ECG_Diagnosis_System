{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "bpm-runtime",
      "inherits": "ecg-base",
      "cacheVariables": {
        "ECG_BUILD_PROFILE": "bpm-runtime"
      }
    },
    {
      "name": "ecg-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "IDF_TARGET": "esp32",
        "ECG_ENABLE_TFLM": false
      }
    },
    {
      "name": "af-extra-trees",
